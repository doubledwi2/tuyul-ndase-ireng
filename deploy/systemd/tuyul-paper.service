[Unit]
Description=Tuyul virtual paper engine
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=tuyul
Group=tuyul
WorkingDirectory=/opt/tuyul-ndase-ireng
EnvironmentFile=/etc/tuyul-paper.env
ExecStart=/usr/bin/node /opt/tuyul-ndase-ireng/dist/paper.js
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
