DATA_DIR=/var/lib/tuyul-paper
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
CHECKPOINT_EVERY_EVENTS=100
JOURNAL_COMPACT_AFTER_RECORDS=10000
JOURNAL_MAX_BYTES=52428800
MAX_JOURNAL_ARCHIVES=3
MAX_FEED_SILENCE_MS=5000
MIN_FREE_DISK_MB=500
MAX_CHECKPOINT_AGE_MS=300000
MAX_PERSISTENCE_QUEUE_DEPTH=1000
EXECUTION_MODE=paper
REAL_EXECUTION_ENABLED=false
EXECUTION_KILL_SWITCH=true
PRIVATE_READ_ENABLED=false
ACCOUNT_FEE_MODE=diagnostic
# Optional cache-only hypothetical economics; requires PRIVATE_READ_ENABLED=true.
SHADOW_MODE_ENABLED=false
# Hypothetical post-arrival book simulation; requires both shadow/private-read flags.
SHADOW_EXECUTION_ENABLED=false
# Public metadata only; independent of private-read/shadow flags.
INSTRUMENT_RULES_ENABLED=true
INSTRUMENT_RULES_POLL_INTERVAL_MS=300000
BYBIT_API_BASE_URL=https://api.bybit.com
OKX_API_BASE_URL=https://openapi.okx.com
